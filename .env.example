# Runtime mode
APP_MODE=development
ENABLE_DEMO_DATA=true

# PostgreSQL / durable task state
DATABASE_URL=postgresql://agent_reader:reader_demo@localhost:55432/scientific_agent
ADMIN_DATABASE_URL=postgresql://scientific:scientific@localhost:55432/scientific_agent
CHECKPOINT_DATABASE_URL=postgresql://scientific:scientific@localhost:55432/scientific_agent

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=scientific-files
MINIO_SECURE=false

# Preferred OpenAI-compatible LLM variables
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen3.7-flash

# Backward-compatible aliases (optional; LLM_* wins)
OPENAI_API_BASE=
OPENAI_API_KEY=
LLM_MODEL_NAME=

# Scientific model integration is intentionally disabled until a real adapter is configured
MODEL_PATH=

# Runtime limits
MAX_REPLANS=2
MAX_TOOL_CALLS=16
TASK_TIMEOUT=120
MAX_ROWS=500
